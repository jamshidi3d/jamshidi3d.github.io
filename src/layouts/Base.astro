---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE, LINKS } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
}

const { title, description = SITE.description, image = '/media/img/khosrobot.png', type = 'website', canonical: canonicalPath } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · physics, graphics, tools`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  url: SITE.url,
  jobTitle: 'Physics PhD candidate and technical artist',
  sameAs: [LINKS.github, LINKS.linkedin, LINKS.scholar, LINKS.orcid].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="robots" content="noai, noimageai" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>© MH Jamshidi. The Khosrobot character, its model and textures are all rights reserved.</p>
          <p class="mono">Code MIT · writing, images and video CC BY-NC 4.0 unless marked otherwise</p>
          <p class="mono">Embedded videos load from YouTube only when you play them.</p>
        </div>
        <p class="mono">
          <a href={LINKS.github} rel="noopener">GitHub</a> ·
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>

    <script>
      // Short muted loops play on hover only (never with reduced motion).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        document.querySelectorAll<HTMLElement>('[data-hover-video]').forEach((el) => {
          const v = el.querySelector('video');
          if (!v) return;
          const host = el.closest('a, .item') ?? el;
          host.addEventListener('pointerenter', (e) => {
            if ((e as PointerEvent).pointerType !== 'mouse') return;
            if (!v.src) v.src = v.dataset.src ?? '';
            v.play().then(() => v.classList.add('on')).catch(() => {});
          });
          host.addEventListener('pointerleave', () => {
            v.pause();
            v.classList.remove('on');
          });
        });
      }
    </script>
  </body>
</html>
