---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE, LINKS } from '../data/site';
import { breadcrumbLd, personLd, websiteLd, type JsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  jsonLd?: JsonLd[]; // extra structured data for the page (articles, applications ...), added to the graph
  heroFont?: boolean; // Home only: preload the hero headline font and the title font (card titles are on the first screen)
}

const { title, description = SITE.description, image = '/media/img/og-card.jpg', type = 'website', canonical: canonicalPath, heroFont = false, jsonLd = [] } = Astro.props;
// the home page carries the full name (what people search for) and what the work is; the other pages the short name
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.fullName} · technical artist and physics researcher`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const isDefaultImage = image === '/media/img/og-card.jpg'; // its size is known; pages with their own picture leave the size out
const graph = {
  '@context': 'https://schema.org',
  '@graph': [personLd(), websiteLd(), breadcrumbLd(Astro.url.pathname, title), ...jsonLd].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d1117" />
    <meta name="robots" content="noai, noimageai" />
    {heroFont && <link rel="preload" href="/fonts/oxanium-800.woff2" as="font" type="font/woff2" crossorigin />}
    {heroFont && <link rel="preload" href="/fonts/sofia-600.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/ubuntu-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicons/favicon.ico?v=5" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png?v=5" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png?v=5" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.fullName} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    {isDefaultImage && <meta property="og:image:alt" content={`${SITE.fullName}: physics, animation, tools, with the Khosrobot character`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>© MH Jamshidi. The Khosrobot character, its model and textures are all rights reserved.</p>
          <p class="mono">Code MIT · writing, images and video CC BY-NC 4.0 unless marked otherwise</p>
          <p class="mono">Embedded videos and 3D models load from YouTube and Sketchfab only when you play them.</p>
        </div>
        <nav class="foot-links" aria-label="Footer">
          <a class="foot-btn gold" href="/contact/">Contact</a>
          <a class="foot-btn" href={LINKS.github} rel="noopener">GitHub</a>
          <a class="foot-btn" href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    <script>
      // Hover previews: a small premade GIF is fetched on first hover and shown over the still.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        document.querySelectorAll<HTMLElement>('[data-hover-preview]').forEach((el) => {
          const img = el.querySelector<HTMLImageElement>('img.prev');
          if (!img) return;
          const host = el.closest('a, .item') ?? el;
          host.addEventListener('pointerenter', (e) => {
            if ((e as PointerEvent).pointerType !== 'mouse') return;
            if (!img.src) img.src = img.dataset.src ?? '';
            img.classList.add('on');
          });
          host.addEventListener('pointerleave', () => img.classList.remove('on'));
        });
      }
    </script>
  </body>
</html>
