---
import Base from '../layouts/Base.astro';
import Listing from '../components/Listing.astro';
import { allItems } from '../lib/items';
import { LINKS } from '../data/site';

const press = (await allItems())
  .filter((i) => i.byline && i.external)
  .sort((x, y) => y.date.getTime() - x.date.getTime());

const links = [
  { label: 'Email', href: `mailto:${LINKS.email}`, text: LINKS.email },
  { label: 'GitHub', href: LINKS.github, text: 'github.com/Jamshidi3d' },
  LINKS.linkedin && { label: 'LinkedIn', href: LINKS.linkedin, text: 'LinkedIn' },
  LINKS.scholar && { label: 'Scholar', href: LINKS.scholar, text: 'Google Scholar' },
  LINKS.orcid && { label: 'ORCID', href: LINKS.orcid, text: 'ORCID' },
  LINKS.inspire && { label: 'INSPIRE', href: LINKS.inspire, text: 'INSPIRE' },
  LINKS.cvIndustry && { label: 'CV, game industry', href: LINKS.cvIndustry, text: 'PDF' },
  LINKS.cvAcademic && { label: 'CV, academic', href: LINKS.cvAcademic, text: 'PDF' },
].filter(Boolean) as { label: string; href: string; text: string }[];

const credits = [
  ['three.js', 'MIT', 'https://threejs.org'],
  ['Rapier', 'Apache-2.0', 'https://rapier.rs'],
  ['Astro', 'MIT', 'https://astro.build'],
  ['KaTeX', 'MIT', 'https://katex.org'],
  ['Shiki', 'MIT', 'https://shiki.style'],
  ['Oxanium', 'SIL OFL 1.1', 'https://github.com/sevmeyer/oxanium'],
  ['Sofia Sans Semi Condensed', 'SIL OFL 1.1', 'https://fonts.google.com/specimen/Sofia+Sans+Semi+Condensed'],
  ['Ubuntu', 'Ubuntu Font Licence 1.0', '/fonts/UFL-LICENSE.txt'],
  ['Commit Mono', 'SIL OFL 1.1', 'https://commitmono.com'],
  ['Red Hat Text', 'SIL OFL 1.1', 'https://github.com/RedHatOfficial/RedHatFont'],
];
---

<Base title="About" description="MH Jamshidi: physics PhD candidate in cosmology and technical artist since 2012.">
  <div class="wrap">
    <header class="page-head">
      <h1>About</h1>
    </header>

    <div class="cv-row">
      <a class="cv-btn" href={LINKS.cvIndustry}>CV, Game industry</a>
      <a class="cv-btn" href={LINKS.cvAcademic}>CV, Academic</a>
    </div>

    <div class="prose">
      <p>
        I'm a PhD candidate in physics, working on gravitation and cosmology, and I have worked as a
        technical artist since 2012. I started in the game industry that year, modelling for the game{' '}
        <a href="https://store.steampowered.com/app/353990/Parvaneh_Legacy_of_the_Lights_Guardians/" rel="noopener">Parvaneh</a>.
        Because of my background in mathematics and physics, and my interest in technical art, I soon moved
        to tool development and physics-based assets. Since then I have done rigging and tool and shader
        development in Blender, Maya, 3ds Max and Unity.
      </p>
      <p>
        On the academic side I gradually moved toward computational physics, which was a good context for
        improving both my scientific and my game-production skills. Alongside research in cosmology, my
        old dream, I work on physics-based tools that help technical artists and animators.
      </p>

      <h2>Press</h2>
      <Listing items={press} variant="row" />

      <h2>Links</h2>
      <table class="tbl">
        <tbody>
          {links.map((l) => (
            <tr>
              <th scope="row">{l.label}</th>
              <td><a href={l.href} rel="noopener">{l.text}</a></td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Credits</h2>
      <p style="font-size:17px">
        Built with open-source software. Writing, images and video are CC BY-NC 4.0 and code is MIT, unless
        a file says otherwise. Embedded YouTube videos and Sketchfab models load from those sites only when played. The Khosrobot character, its model and textures are all rights reserved.
      </p>
      <table class="tbl">
        <thead>
          <tr><th>Name</th><th>Licence</th></tr>
        </thead>
        <tbody>
          {credits.map(([name, licence, href]) => (
            <tr>
              <td><a href={href} rel="noopener">{name}</a></td>
              <td class="mono" style="font-size:13px">{licence}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>

<style>
  .cv-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0 0 40px;
  }
  /* key-cap buttons, same as the Contact button in the top bar */
  .cv-btn {
    display: inline-block;
    background: var(--gold);
    color: var(--ink);
    font-size: 15px;
    padding: 8px 18px;
    border: 2px solid var(--bg);
    border-radius: 8px;
    box-shadow: 0 5px 0 var(--shadow);
    text-decoration: none;
    transition: transform 0.08s linear, box-shadow 0.08s linear;
  }
  .cv-btn:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .cv-btn:hover {
      background: var(--white);
      transform: translateY(-2px);
      box-shadow: 0 7px 0 var(--shadow);
    }
    .cv-btn:active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 var(--shadow);
    }
  }
</style>
