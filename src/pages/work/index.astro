---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import GameCard from '../../components/GameCard.astro';
import { GAMES } from '../../data/games';
import TagFilter from '../../components/TagFilter.astro';
import { getProjects, projectItem, getModels, modelItem } from '../../lib/items';
import { THEMES, ROLE_TAGS } from '../../data/site';

const models = (await getModels()).map(modelItem);
const items = (await getProjects()).map(projectItem);
const groups = THEMES.map((t) => ({ theme: t, items: items.filter((i) => i.theme === t) })).filter(
  (g) => g.items.length,
);
---

<Base title="Work" canonical="/work/" description="Games, rigging, simulation and tools: projects by theme, from game animation to physics-based rigging.">
  <div class="wrap" id="work">
    <header class="page-head">
      <h1>Work</h1>
      <p class="lede">Games, rigging, simulation and tools, from game animation to physics-based rigging.</p>
    </header>

    <TagFilter scope="#work" tags={['games', ...ROLE_TAGS]} />

    <section class="group" id="games" data-group>
      <h2 class="label amber">
        <span class="chip">Games</span>
        <span class="count">{GAMES.length} titles</span>
      </h2>
      <div class="cards games">
        {GAMES.map((game) => <GameCard game={game} />)}
      </div>
    </section>

    {
      groups.map((g) => (
        <section class="group" data-group>
          <h2 class="label amber">
            <span class="chip">{g.theme}</span>
            <span class="count">{g.items.length}</span>
          </h2>
          <Listing items={g.items} variant="row" />
        </section>
      ))
    }

    {
      models.length > 0 && (
        <section class="group" data-group id="modeling">
          <h2 class="label amber">
            <span class="chip">Modeling</span>
            <span class="count">{models.length}</span>
          </h2>
          <div class="models">
            <Listing items={models} variant="card" />
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .models,
  .games {
    margin-top: 24px;
  }
</style>
