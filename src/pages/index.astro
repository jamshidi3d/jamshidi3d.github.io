---
import Base from '../layouts/Base.astro';
import Interactive from '../components/Interactive.astro';
import Listing from '../components/Listing.astro';
import TagFilter from '../components/TagFilter.astro';
import { allItems, getModels, modelItem } from '../lib/items';
import { SITE, LINKS } from '../data/site';

const featured = (await allItems())
  .filter((i) => i.home !== undefined)
  .sort((a, b) => a.home! - b.home!);
const everything = [...(await allItems()), ...(await getModels()).map(modelItem)];
// With a tag filter on, every matching item is shown (not only the featured ones): featured first, then newest.
const filterPool = everything.sort(
  (a, b) => (a.home ?? 999) - (b.home ?? 999) || b.date.getTime() - a.date.getTime(),
);
// Gold-accent hero: "Physics" sits on a gold plate; two phrases in the intro become inline pills.
const [tagBefore, tagAfter] = SITE.tagline.split('Physics');
const pills = ['PhD candidate in cosmology', 'technical artist'];
const introParts = SITE.intro.split(new RegExp(`(${pills.join('|')})`));
const cards = featured.slice(0, 3);
const rows = featured.slice(3);
---

<Base heroFont>
  <div class="wrap">
    <section class="hero" aria-labelledby="slogan">
      <div class="hl">
        <h1 id="slogan">{tagBefore}<span class="mv">Physics</span>{tagAfter}</h1>
      </div>
      <Interactive name="hero" poster="/media/img/khosrobot-hero-blur.webp" label="The Khosrobot character, a gold one-wheel robot. Drag it to push it around." fill bare />
      <div class="hr">
        <p class="intro">
          {introParts.map((t) => (pills.includes(t) ? <code>{t}</code> : t))}
        </p>
        {
          (LINKS.cvIndustry || LINKS.cvAcademic) && (
            <p class="quiet">
              <a href={LINKS.cvIndustry ?? LINKS.cvAcademic}>CV</a>
            </p>
          )
        }
      </div>
    </section>

    <section class="home-list" id="featured" aria-labelledby="featured-h">
      <div class="section-head">
        <h2 class="label amber" id="featured-h" style="font-weight:400">Featured and latest</h2>
        <TagFilter scope="#featured" />
      </div>
      <div data-view="all">
        <Listing items={cards} variant="card" />
        <Listing items={rows} variant="row" />
      </div>
      <!-- With a tag filter active, every matching item is shown as a card. -->
      <div data-view="filtered" hidden>
        <Listing items={filterPool} variant="card" />
      </div>
    </section>
  </div>
</Base>
