---
import Base from '../layouts/Base.astro';

const live = [
  ['Khosrobot lab', 'The Khosrobot rig in the browser: geometry-based and physics-based rigging working together.', '/lab/khosrobot/', '/media/img/khosrobot-lab-thumb.webp'],
  ['CMB Map', 'A map of the CMB temperature fluctuations and its mask on a HEALPix sphere, from Nside 16 to 256: from outside, as an observer, and as a Mollweide map.', '/lab/cmb-lab/', '/media/img/cmb-lab-thumb.webp'],
  ['CMB Power Spectrum', 'The TT, EE and TE angular power spectra of the CMB, redrawn as you change the six parameters of a flat ΛCDM universe. CAMB runs on a grid, interpolated in the browser.', '/lab/cmb-power-spectrum/', '/media/img/cmb-power-spectrum-thumb.webp'],
  ['Spherical Harmonics', 'The real or imaginary part of any spherical harmonic up to degree 512 on a HEALPix sphere, from outside or as a Mollweide map.', '/lab/spherical-harmonics/', '/media/img/spherical-harmonics-thumb.webp'],
];
const planned = [
  ['Quadruped animation factory', 'Generate quadruped animations in the browser.'],
  ['CMB Doppler boost', 'How our motion shifts and distorts the CMB sky.'],
  ['Gravitational lensing', 'How mass bends light and distorts the image behind it.'],
];
---

<Base title="Lab" description="Small interactive web apps and simulations. The Khosrobot rig, CMB Map, Spherical Harmonics and the CMB Power Spectrum are live; the rest are in progress.">
  <div class="wrap">
    <header class="page-head">
      <h1>Lab</h1>
      <p class="lede">Small interactive web apps and simulations. The Khosrobot rig, CMB Map, Spherical Harmonics and the CMB Power Spectrum are live; the rest are in progress.</p>
    </header>

    <section class="group">
      <span class="label amber">Live</span>
      <div class="rows">
        {
          live.map(([title, blurb, href, thumb]) => (
            <a class="item row" href={href}>
              <div class="thumb">
                <img src={thumb} alt="" loading="lazy" width="132" height="76" />
              </div>
              <div class="body">
                <h3>{title}</h3>
                <p class="blurb">{blurb}</p>
              </div>
              <div class="meta"><span class="kind">Lab</span><span>live</span></div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="group">
      <span class="label amber">In progress</span>
      <div class="rows">
        {
          planned.map(([title, blurb]) => (
            <div class="item row nothumb">
              <div class="body">
                <h3>{title}</h3>
                <p class="blurb">{blurb}</p>
              </div>
              <div class="meta"><span class="kind">Lab</span><span>soon</span></div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>
