---
import Base from '../layouts/Base.astro';

const live = [
  ['Khosrobot lab', 'The Khosrobot rig in the browser: geometry-based and physics-based rigging working together.', '/lab/khosrobot/'],
];
const planned = [
  ['Spring chain', 'Drag a mass and watch the wave travel.'],
  ['CMB sky, cap and mask', 'Slide a hemispherical cap over the Galactic mask.'],
  ['Double pendulum', 'Tiny changes, wildly different paths.'],
];
---

<Base title="Lab" description="Small interactive web apps and simulations. The Khosrobot rig is live; the rest are in progress.">
  <div class="wrap">
    <header class="page-head">
      <h1>Lab</h1>
      <p class="lede">Small interactive web apps and simulations. The Khosrobot rig is live; the rest are in progress.</p>
    </header>

    <section class="group">
      <span class="label amber">Live</span>
      <div class="rows">
        {
          live.map(([title, blurb, href]) => (
            <a class="item row nothumb" href={href}>
              <div class="body">
                <h3>{title}</h3>
                <p class="blurb">{blurb}</p>
              </div>
              <div class="meta"><span class="kind">Lab</span><span>live</span></div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="group">
      <span class="label amber">In progress</span>
      <div class="rows">
        {
          planned.map(([title, blurb]) => (
            <div class="item row nothumb">
              <div class="body">
                <h3>{title}</h3>
                <p class="blurb">{blurb}</p>
              </div>
              <div class="meta"><span class="kind">Lab</span><span>soon</span></div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>
