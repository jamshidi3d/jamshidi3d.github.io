---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { getPosts, fmtDate } from '../../lib/items';

export async function getStaticPaths() {
  const posts = (await getPosts()).filter((p) => !p.data.external);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
---

<Base title={d.title} description={d.dek ?? d.blurb} image={d.image} type="article">
  <div class="wrap post-wrap">
    <aside class="rail" aria-label="On this page">
      <a class="back label" href="/writing/">← Writing</a>
      {
        toc.length > 0 && (
          <nav class="toc">
            <div class="label">On this page</div>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>

    <article class="post">
      <header>
        <div class="label">
          <span class="amber">Writing</span> · {fmtDate(d.date)} · {minutes} min read
        </div>
        <h1>{d.title}</h1>
        {d.dek && <p class="dek">{d.dek}</p>}
        {d.tags.length > 0 && <p class="tags mono">{d.tags.map((t) => `#${t}`).join(' ')}</p>}
      </header>

      {
        toc.length > 0 && (
          <details class="toc-m">
            <summary class="label">On this page</summary>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {d.videos.length > 0 && d.videos.map((v) => <YouTube {...v} />)}

      <div class="body">
        <Content />
      </div>

      <footer class="post-foot">
        <p class="mono licence">Text CC BY-NC 4.0 · code MIT · <a href="https://github.com/Jamshidi3d/jamshidi3d.github.io" rel="noopener">source on GitHub</a></p>
        <div class="prevnext">
          {
            older ? (
              <a href={`/writing/${older.id}/`}>
                <span class="label">Previous</span>
                <span class="t">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a href={`/writing/${newer.id}/`} class="next">
                <span class="label">Next</span>
                <span class="t">{newer.data.title}</span>
              </a>
            )
          }
        </div>
      </footer>
    </article>
  </div>
</Base>

<style is:global>
  .post-wrap {
    display: grid;
    grid-template-columns: 190px minmax(0, 680px) 190px;
    justify-content: center;
    gap: 72px;
    padding-top: 48px;
  }
  .rail {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
    font-size: 14px;
  }
  .rail .back {
    display: inline-block;
    margin-bottom: 36px;
  }
  .rail .back:hover {
    color: var(--amber);
    text-decoration: none;
  }
  .toc ul,
  .toc-m ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--line);
  }
  .toc li,
  .toc-m li {
    margin: 0 0 10px;
    line-height: 1.35;
  }
  .toc a {
    color: var(--text-3);
  }
  .toc a.active {
    color: var(--amber);
  }
  .toc a:hover {
    text-decoration: none;
    color: var(--text);
  }
  .toc-m {
    display: none;
  }
  .post header {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .post h1 {
    font-weight: 600;
    font-size: clamp(32px, 5vw, 46px);
    margin: 16px 0 18px;
  }
  .dek {
    font-family: var(--font-read);
    font-size: 21px;
    line-height: 1.5;
    color: var(--text-3);
    margin: 0 0 16px;
  }
  .post .tags {
    font-size: 12.5px;
    color: var(--muted);
    margin: 0;
  }
  .body {
    font-family: var(--font-read);
    font-size: 19px;
    line-height: 1.72;
    color: var(--text-2);
  }
  .body h2 {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 28px;
    margin: 56px 0 16px;
    color: var(--text);
  }
  .body h3 {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 21px;
    margin: 36px 0 10px;
    color: var(--text);
  }
  .body strong {
    color: var(--text);
  }
  .body a {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* the highlighter's dim comment colour is just under AA on the code panel */
  .code-block pre.astro-code span[style*="768390"] {
    color: #8a96a8 !important;
  }
  .body img {
    margin: 28px auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--image-bg);
  }
  .body blockquote {
    margin: 24px 0;
    padding: 4px 20px;
    border-left: 2px solid var(--amber);
    background: var(--surface);
    border-radius: 0 8px 8px 0;
    font-size: 17px;
  }
  .body blockquote p {
    margin: 0.6em 0;
  }
  .body code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .body kbd {
    font-family: var(--font-mono);
    font-size: 0.78em;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 6px;
  }
  .code-block {
    margin: 26px 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .code-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .code-bar button {
    background: none;
    border: 0;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .code-bar button:hover {
    color: var(--amber);
  }
  .code-block pre.astro-code {
    margin: 0;
    padding: 16px 18px;
    background: var(--surface) !important;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .code-block pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }
  .katex-display {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px 12px;
    margin: 28px 0;
    overflow-x: auto;
    font-size: 1.3em;
  }
  .post-foot {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .licence {
    font-size: 12.5px;
    color: var(--muted);
  }
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 24px;
  }
  .prevnext a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--text);
  }
  .prevnext a:hover {
    text-decoration: none;
    color: #fff;
  }
  .prevnext .t {
    font-family: var(--font-title);
    font-size: 17px;
  }
  .prevnext .next {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 1100px) {
    .post-wrap {
      grid-template-columns: minmax(0, 680px);
      gap: 0;
    }
    .rail {
      display: none;
    }
    .toc-m {
      display: block;
      margin: 0 0 32px;
      padding: 12px 16px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
    }
    .toc-m summary {
      cursor: pointer;
    }
  }
  @media (max-width: 760px) {
    .body {
      font-size: 18px;
    }
    .body img {
      width: 100%;
    }
  }
</style>

<script>
  // Code blocks: header bar with language + copy button.
  document.querySelectorAll<HTMLPreElement>('.body pre.astro-code').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = document.createElement('span');
    lang.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
    bar.append(lang, btn);
    pre.replaceWith(wrap);
    wrap.append(bar, pre);
  });

  // Table of contents: highlight the section in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const heads = [...document.querySelectorAll<HTMLElement>('.body h2[id]')];
  if (links.size && heads.length) {
    const setActive = (id: string) => links.forEach((a, k) => a.classList.toggle('active', k === id));
    const update = () => {
      let cur = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top < 140) cur = h.id;
      setActive(cur);
    };
    document.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
