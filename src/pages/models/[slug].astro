---
import Base from '../../layouts/Base.astro';
import ModelEmbed from '../../components/ModelEmbed.astro';
import { getModels } from '../../lib/items';

export async function getStaticPaths() {
  const models = await getModels();
  return models.map((m) => ({ params: { slug: m.id }, props: { model: m } }));
}

const { model } = Astro.props;
const d = model.data;
---

<Base title={d.title} description={d.blurb} image={d.image}>
  <div class="wrap model-page">
    <a class="back label" href="/work/#modeling">← Work</a>

    <header class="m-title">
      <div class="label amber">Modeling</div>
      <h1>{d.title}</h1>
      <p class="m-blurb">{d.blurb}</p>
    </header>

    <ModelEmbed title={d.title} {...d.sketchfab} audio={d.audio} />

    <p class="mono m-tags">
      {d.tags.map((t) => `#${t}`).join(' ')}
      {d.tools.length > 0 && ` · ${d.tools.join(' · ')}`}
      {d.triangles && ` · ${d.triangles} tris`}
    </p>
  </div>
</Base>

<style>
  .model-page {
    padding-top: 40px;
    max-width: 1100px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
  }
  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .m-title {
    margin-bottom: 28px;
  }
  .m-title h1 {
    font-weight: 600;
    font-size: clamp(34px, 5vw, 56px);
    margin: 14px 0;
  }
  .m-blurb {
    font-size: 20px;
    color: var(--text-3);
    margin: 0;
  }
  .m-tags {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 18px;
  }
</style>
