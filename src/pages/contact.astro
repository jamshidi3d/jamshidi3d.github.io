---
import Base from '../layouts/Base.astro';
import { LINKS } from '../data/site';

const links = [
  { label: 'GitHub', href: LINKS.github, text: 'github.com/Jamshidi3d' },
  LINKS.linkedin && { label: 'LinkedIn', href: LINKS.linkedin, text: 'LinkedIn' },
  LINKS.scholar && { label: 'Scholar', href: LINKS.scholar, text: 'Google Scholar' },
  LINKS.orcid && { label: 'ORCID', href: LINKS.orcid, text: 'ORCID' },
  LINKS.inspire && { label: 'INSPIRE', href: LINKS.inspire, text: 'INSPIRE' },
].filter(Boolean) as { label: string; href: string; text: string }[];
---

<Base title="Contact" description="How to reach MohammadHossein Jamshidi (MH Jamshidi): email, GitHub and what to write about: roles in tools, physics or animation programming and technical art, cosmology and visualisation, and the work on this site.">
  <div class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="lede">The easiest way to reach me is email.<br />I usually reply within a day or two.</p>
    </header>

    <div class="cols">
      <div class="prose">
        <div class="mail">
          <a class="mail-addr" href={`mailto:${LINKS.email}`}>{LINKS.email}</a>
          <button class="copy-btn" id="copy-btn" type="button" data-email={LINKS.email}>Copy address</button>
          <span class="copy-note mono" id="copy-note" role="status" aria-live="polite"></span>
        </div>

        <h2>Elsewhere</h2>
        <table class="tbl">
          <tbody>
            {links.map((l) => (
              <tr>
                <th scope="row">{l.label}</th>
                <td><a href={l.href} rel="noopener">{l.text}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prose reasons">
        <h2>Good reasons to write</h2>
        <ul>
          <li>A role in physics or animation programming, tools development or technical art.</li>
          <li>Cosmology: CMB data, CMB anomalies, maps and their visualization.</li>
          <li>Collaboration in physics, animation, graphics or tools.</li>
          <li>A question about the work, posts or demos on this site, such as Physirig, the Khosrobot lab, the CMB Lab or the Blender geometry-nodes posts.</li>
        </ul>
        <p style="font-size:17px">
          It helps to include a link or a few lines about what you are working on, and any deadline.
        </p>
      </div>
    </div>
  </div>
</Base>

<script>
  const btn = document.getElementById('copy-btn') as HTMLButtonElement | null;
  const note = document.getElementById('copy-note');
  let timer = 0;
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email ?? '';
    let ok = false;
    try {
      await navigator.clipboard.writeText(email);
      ok = true;
    } catch {
      // no clipboard access (an old browser, or an insecure page): select the address so Ctrl+C works
      const addr = document.querySelector<HTMLElement>('.mail-addr');
      if (addr) {
        const range = document.createRange();
        range.selectNodeContents(addr);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
    if (note) note.textContent = ok ? 'Copied' : 'Press Ctrl+C to copy';
    clearTimeout(timer);
    timer = window.setTimeout(() => note && (note.textContent = ''), 2500);
  });
</script>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .cols .prose {
    max-width: none;
  }
  .reasons h2:first-child {
    margin-top: 0; /* level with the top of the address card */
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .reasons h2:first-child {
      margin-top: 56px;
    }
  }
  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 7px 0 var(--shadow);
    padding: 29px 26px 15px; /* more above than below: the hard shadow under the card makes the text look high otherwise */
    margin-bottom: 8px;
  }
  .mail-addr {
    font-family: var(--font-mono);
    font-size: clamp(17px, 2.4vw, 24px);
    color: var(--gold);
    overflow-wrap: anywhere;
  }
  .mail-addr:hover {
    color: var(--text);
  }
  .copy-btn {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    padding: 6px 16px;
    min-height: 36px;
  }
  .copy-btn:hover {
    color: var(--ink);
    background: var(--gold);
  }
  .copy-note {
    font-size: 13px;
    color: var(--muted);
    min-width: 8em;
  }
</style>
