---
// Placeholder hero: the gold one-wheel robot on a round stage. The Khosrobot character replaces it later.
// Pure SVG + CSS (no WebGL); the Pause button stops the idle bob.
---

<div class="stage-col" id="stage-col">
  <div class="stage" id="stage" role="img" aria-label="A gold one-wheel robot, a placeholder for an interactive character">
    <svg class="bot" viewBox="0 0 220 310" aria-hidden="true">
      <ellipse cx="110" cy="300" rx="78" ry="9" fill="#05070B" opacity=".55" />
      <g stroke="#05070B" stroke-width="4" stroke-linejoin="round">
        <rect x="44" y="118" width="20" height="54" rx="10" fill="#F2B441" />
        <rect x="156" y="118" width="20" height="54" rx="10" fill="#F2B441" />
        <circle cx="54" cy="178" r="9" fill="#C98A1B" />
        <circle cx="166" cy="178" r="9" fill="#C98A1B" />
      </g>
      <g stroke="#05070B" stroke-width="4" stroke-linejoin="round">
        <rect x="66" y="104" width="88" height="96" rx="22" fill="#F2B441" />
        <rect x="84" y="128" width="52" height="38" rx="9" fill="#C98A1B" />
        <circle cx="98" cy="147" r="6" fill="#F2B441" stroke-width="3" />
        <rect x="112" y="141" width="14" height="12" rx="3" fill="#FFD97A" stroke-width="3" />
      </g>
      <g stroke="#05070B" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
        <line x1="110" y1="40" x2="110" y2="14" />
        <circle cx="110" cy="11" r="7" fill="#F2B441" />
        <rect x="68" y="38" width="84" height="64" rx="20" fill="#F2B441" />
        <rect x="80" y="54" width="60" height="28" rx="14" fill="#0A1630" />
        <circle cx="98" cy="68" r="5.5" fill="#F2B441" stroke="none" />
        <circle cx="122" cy="68" r="5.5" fill="#F2B441" stroke="none" />
        <path d="M80 46c8-5 20-6 30-6" stroke="#FFD97A" stroke-width="4" fill="none" />
      </g>
      <g stroke="#05070B" stroke-width="4">
        <circle cx="110" cy="236" r="64" fill="#1B2029" />
        <circle cx="110" cy="236" r="46" fill="#F2B441" />
        <circle cx="110" cy="236" r="17" fill="#C98A1B" />
        <circle cx="110" cy="236" r="6" fill="#05070B" />
        <g stroke-width="3" stroke="#C98A1B" fill="none">
          <line x1="110" y1="196" x2="110" y2="219" />
          <line x1="110" y1="253" x2="110" y2="276" />
          <line x1="70" y1="236" x2="93" y2="236" />
          <line x1="127" y1="236" x2="150" y2="236" />
        </g>
      </g>
      <path d="M70 218a46 46 0 0 1 32-24" fill="none" stroke="#FFD97A" stroke-width="5" stroke-linecap="round" opacity=".9" />
    </svg>
  </div>
  <button class="stage-btn" id="stage-btn" type="button" aria-pressed="false"><i aria-hidden="true"></i><span>Pause</span></button>
</div>

<script>
  const stage = document.getElementById('stage') as HTMLElement;
  const btn = document.getElementById('stage-btn') as HTMLButtonElement;
  const label = btn.querySelector('span') as HTMLElement;

  btn.addEventListener('click', () => {
    const paused = stage.classList.toggle('paused');
    btn.setAttribute('aria-pressed', String(paused));
    label.textContent = paused ? 'Play' : 'Pause';
  });
</script>
