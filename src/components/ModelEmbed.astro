---
// Sketchfab viewer for a model's own page: it starts loading as soon as the page opens.
// The soundtrack loops, the visitor can switch it on and off, and it is only started once the model is ready.
interface Props {
  title: string;
  id: string;
  slug: string;
  audio?: { src: string; credit: string; creditUrl?: string };
}

const { title, id, slug, audio } = Astro.props;
const page = `https://sketchfab.com/3d-models/${slug}-${id}`;
---

<figure class="model">
  <div class="model-box" data-model={id} data-title={title} data-audio={audio?.src}>
    <div class="model-controls" hidden>
      {audio && <button class="model-btn model-sound" type="button" aria-pressed="false" hidden>Sound off</button>}
      <button class="model-btn model-full" type="button">Full screen</button>
    </div>
  </div>
  <figcaption class="model-meta">
    <a href={page} rel="noopener" target="_blank">View on Sketchfab ↗</a>
    {
      audio && (
        <span class="model-credit">
          Sound: {audio.creditUrl ? <a href={audio.creditUrl} rel="noopener" target="_blank">{audio.credit}</a> : audio.credit}
        </span>
      )
    }
  </figcaption>
</figure>

<style is:global>
  .model {
    margin: 0;
  }
  .model-box {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 72vh;
    width: 100%;
    background: var(--image-bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .model-box:fullscreen {
    border: 0;
    border-radius: 0;
    aspect-ratio: auto;
    max-height: none;
  }
  .model-box iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .model-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    gap: 8px;
  }
  .model-btn {
    background: rgba(13, 17, 23, 0.8);
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 7px 12px;
    cursor: pointer;
  }
  .model-btn:hover {
    color: var(--amber);
    border-color: var(--amber);
  }
  .model-meta {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  /* sound name and reference: small and grey */
  .model-credit,
  .model-credit a {
    font-size: 11px;
    color: var(--muted);
  }
  .model-credit a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  const API = 'https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js';

  function loadApi(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).Sketchfab) return resolve();
      const s = document.createElement('script');
      s.src = API;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('Sketchfab API failed to load'));
      document.head.append(s);
    });
  }

  document.querySelectorAll<HTMLElement>('.model-box[data-model]').forEach(async (box) => {
    const controls = box.querySelector<HTMLElement>('.model-controls')!;
    const soundBtn = box.querySelector<HTMLButtonElement>('.model-sound');
    const fullBtn = box.querySelector<HTMLButtonElement>('.model-full')!;
    const id = box.dataset.model!;

    // Full screen (vendor-prefixed fallback for older Safari).
    const fsEl = () => document.fullscreenElement ?? (document as any).webkitFullscreenElement;
    fullBtn.addEventListener('click', () => {
      if (fsEl() === box) (document.exitFullscreen ?? (document as any).webkitExitFullscreen).call(document);
      else (box.requestFullscreen ?? (box as any).webkitRequestFullscreen)?.call(box);
    });
    document.addEventListener('fullscreenchange', () => {
      fullBtn.textContent = fsEl() === box ? 'Exit full screen' : 'Full screen';
    });

    // Soundtrack: loops; the visitor switches it on and off.
    let audio: HTMLAudioElement | null = null;
    if (box.dataset.audio && soundBtn) {
      audio = new Audio(box.dataset.audio);
      audio.loop = true;
      audio.preload = 'auto';
      const label = () => {
        const on = !audio!.paused;
        soundBtn.setAttribute('aria-pressed', String(on));
        soundBtn.textContent = on ? 'Sound on' : 'Sound off';
      };
      audio.addEventListener('play', label);
      audio.addEventListener('pause', label);
      soundBtn.addEventListener('click', () => {
        if (audio!.paused) audio!.play().catch(() => {});
        else audio!.pause();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) audio?.pause();
      });
    }

    // The model is ready: show the sound button and try to start the sound
    // (browsers may block this without a recent click; the button then starts it).
    const ready = () => {
      controls.hidden = false;
      if (soundBtn) {
        soundBtn.hidden = false;
        audio?.play().catch(() => {});
      }
    };

    const iframe = document.createElement('iframe');
    iframe.title = box.dataset.title ?? '3D model';
    iframe.allow = 'autoplay; fullscreen; xr-spatial-tracking';
    iframe.allowFullscreen = true;
    box.prepend(iframe);
    controls.hidden = false; // fullscreen is available during loading; sound waits for the model
    if (soundBtn) soundBtn.hidden = true;

    // Without the viewer API, use the plain embed (no ready signal: start the sound once it has loaded).
    const fallback = () => {
      iframe.src = `https://sketchfab.com/models/${id}/embed?autostart=1&ui_infos=0&ui_watermark=0&dnt=1`;
      iframe.addEventListener('load', ready, { once: true });
    };

    try {
      await loadApi();
      const client = new (window as any).Sketchfab(iframe);
      client.init(id, {
        ui_infos: 0,
        ui_watermark: 0,
        dnt: 1,
        success: (api: any) => {
          api.start();
          api.addEventListener('viewerready', ready);
        },
        error: fallback,
      });
    } catch {
      fallback();
    }
  });
</script>
