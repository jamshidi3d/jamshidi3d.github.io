---
// Click-to-load YouTube facade. Nothing is requested from YouTube (not even a thumbnail)
// until the visitor clicks play; then a youtube-nocookie.com iframe replaces the facade.
interface Props {
  id: string;
  title: string;
  role: 'mine' | 'by others';
  author?: string;
  start?: number;
}

const { id, title, role, author, start } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}`;
---

<figure class="yt-fig">
  <div class="yt" data-yt={id} data-start={start} data-title={title}>
    <button class="yt-play" type="button" aria-label={`Play video: ${title}`}>
      <span class="yt-icon" aria-hidden="true">▶</span>
      <span class="yt-title">{title}</span>
      <span class="yt-hint label">Click to load from YouTube</span>
    </button>
  </div>
  <figcaption class="yt-meta">
    {role === 'by others' && <span>Video by <a href={watch} rel="noopener" target="_blank">{author ?? 'others'}</a> · </span>}
    <a href={watch} rel="noopener" target="_blank">Watch on YouTube ↗</a>
  </figcaption>
</figure>

<style is:global>
  .yt-fig {
    margin: 0 0 32px;
  }
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--image-bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .yt iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px;
    background: none;
    border: 0;
    color: var(--text);
    cursor: pointer;
    text-align: center;
  }
  .yt-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--amber);
    color: var(--amber);
    display: grid;
    place-items: center;
    font-size: 20px;
    transition: background 150ms ease;
  }
  .yt-play:hover .yt-icon {
    background: rgba(255, 180, 84, 0.12);
  }
  .yt-title {
    font-family: var(--font-head);
    font-size: 20px;
  }
  .yt-meta {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt[data-yt]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.yt-play');
    btn?.addEventListener('click', () => {
      const id = box.dataset.yt!;
      const params = new URLSearchParams({ autoplay: '1', rel: '0', modestbranding: '1' });
      if (box.dataset.start) params.set('start', box.dataset.start);
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
      f.title = box.dataset.title ?? 'YouTube video';
      f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(f);
    });
  });
</script>
