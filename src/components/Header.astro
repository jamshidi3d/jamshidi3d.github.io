---
import { NAV, LINKS } from '../data/site';

const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="MH Jamshidi, home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">MH Jamshidi</span>
        <span class="brand-line">physics · graphics · tools</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a class="contact" href={`mailto:${LINKS.email}`}>Contact</a>
    </nav>

    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="menu" id="menu" role="dialog" aria-label="Menu" aria-modal="true">
    {
      NAV.map((n, i) => (
        <a class="menu-item" href={n.href} aria-current={active(n.href) ? 'page' : undefined}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="title">{n.label}</span>
          <span class="desc">{n.desc}</span>
        </a>
      ))
    }
    <div class="menu-links">
      <a href={`mailto:${LINKS.email}`}>Contact</a>
      <a href={LINKS.github} rel="noopener">GitHub</a>
      {LINKS.cvIndustry && <a href={LINKS.cvIndustry}>CV</a>}
      {LINKS.scholar && <a href={LINKS.scholar} rel="noopener">Scholar</a>}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('menu') as HTMLElement;

  const focusables = () =>
    [btn, ...menu.querySelectorAll<HTMLElement>('a[href]')].filter((el) => el.offsetParent !== null);

  function setOpen(open: boolean) {
    menu.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else btn.focus();
  }

  btn.addEventListener('click', () => setOpen(!menu.classList.contains('open')));

  document.addEventListener('keydown', (e) => {
    if (!menu.classList.contains('open')) return;
    if (e.key === 'Escape') {
      setOpen(false);
    } else if (e.key === 'Tab') {
      // trap focus inside header button + overlay
      const els = focusables();
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Close if the viewport grows past the mobile breakpoint.
  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches && menu.classList.contains('open')) setOpen(false);
  });
</script>
