---
import { fmtDate, type ListItem } from '../lib/items';

interface Props {
  items: ListItem[];
  variant?: 'card' | 'row' | 'index';
}

const { items, variant = 'row' } = Astro.props;

// Sentence-case labels in the mono font: "Work · Nov 2024".
const kindLabel = (k: string) => k.charAt(0) + k.slice(1).toLowerCase();
const dateText = (it: ListItem) => (it.dateLabel !== undefined ? it.dateLabel : fmtDate(it.date));
const tagAttr = (it: ListItem) => it.tags.join(' ');
const extra = (it: ListItem) => (it.external ? { rel: 'noopener', target: '_blank' } : {});
const hasArrow = (it: ListItem) => !!(it.external || it.byline);

// Unique ids per rendered list so a card's accessible name can be its title.
const g = globalThis as { __listingUid?: number };
const uid = (g.__listingUid = (g.__listingUid ?? 0) + 1);
---

{
  variant === 'card' && (
    <div class="cards">
      {items.map((it, i) => {
        const Tag = it.href ? 'a' : 'div';
        const titleId = `card-${uid}-${i}`;
        return (
          <Tag
            class="item card"
            data-tags={tagAttr(it)}
            href={it.href}
            aria-labelledby={it.href ? titleId : undefined}
            {...extra(it)}
          >
            <div class="thumb" data-hover-preview={it.preview ? '' : undefined}>
              {it.image ? <img src={it.image} alt="" loading="lazy" width="900" height="650" /> : <span class="ph">No image yet</span>}
              {it.preview && <img class="prev" data-src={it.preview} alt="" aria-hidden="true" width="320" height="200" />}
            </div>
            <div class="card-body">
              <div class="meta">
                <span class="kind">
                  {kindLabel(it.kind)}
                  {it.byline && <> · {it.byline}</>}
                </span>
                <span class="date">{dateText(it)}</span>
              </div>
              <h3 id={titleId}>
                {it.title}
                {hasArrow(it) && <span class="ext" aria-hidden="true"> ↗</span>}
              </h3>
              <p class="blurb">{it.blurb}</p>
            </div>
          </Tag>
        );
      })}
    </div>
  )
}

{
  variant === 'row' && (
    <div class="rows">
      {items.map((it, i) => {
        const Tag = it.href ? 'a' : 'div';
        return (
          <Tag class:list={['item', 'row', { nothumb: !it.image }]} data-tags={tagAttr(it)} href={it.href} {...extra(it)}>
            {it.image && (
              <div class="thumb" data-hover-preview={it.preview ? '' : undefined}>
                <img src={it.image} alt="" loading="lazy" width="132" height="76" />
                {it.preview && <img class="prev" data-src={it.preview} alt="" aria-hidden="true" width="320" height="200" />}
              </div>
            )}
            <div class="body">
              <h3>
                {it.title}
                {hasArrow(it) && <span class="ext" aria-hidden="true"> ↗</span>}
              </h3>
              {it.blurb && <p class="blurb">{it.blurb}</p>}
            </div>
            <div class="meta">
              <span>
                <span class="kind">{kindLabel(it.kind)}</span>
                {it.byline && <> · {it.byline}</>}
              </span>
              <span>{dateText(it)}</span>
            </div>
          </Tag>
        );
      })}
    </div>
  )
}

{
  variant === 'index' && (
    <div class="rows">
      {items.map((it) => {
        const Tag = it.href ? 'a' : 'div';
        return (
          <Tag class="item index" data-tags={tagAttr(it)} href={it.href} {...extra(it)}>
            <span class="meta">{dateText(it)}</span>
            <span class="meta">
              <span class="kind">{kindLabel(it.kind)}</span>
              {it.byline && <><br />{it.byline}</>}
            </span>
            <div>
              <h3>
                {it.title}
                {hasArrow(it) && <span class="ext" aria-hidden="true"> ↗</span>}
              </h3>
              {it.blurb && <p class="blurb">{it.blurb}</p>}
            </div>
          </Tag>
        );
      })}
    </div>
  )
}
